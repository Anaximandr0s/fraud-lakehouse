# Copy to .env (gitignored) and replace the passwords.

MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
POSTGRES_IMAGE=postgres:18.7
# Not 4.x: Hive 4 metastores drop the get_table call that Spark 3.5's Hive client uses.
HIVE_IMAGE=apache/hive:3.1.3
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
KAFKA_IMAGE=apache/kafka:4.3.2
# Same Python as the Spark image.
PYTHON_IMAGE=python:3.10.22-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.13.7
# 3.3.x, not 3.4: Airflow 3.4 needs Python 3.11 and the project runs Python 3.10 everywhere.
AIRFLOW_IMAGE=apache/airflow:3.3.2-python3.10
# LTS line.
METABASE_IMAGE=metabase/metabase:v0.64.6.2
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
GRAFANA_IMAGE=grafana/grafana:13.3.1
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:v0.55.1

POSTGRES_JDBC_VERSION=42.7.14
# Must match the Hadoop 3.3.4 bundled with Spark 3.5.
SPARK_HADOOP_AWS_VERSION=3.3.4
SPARK_AWS_SDK_V1_VERSION=1.12.262
ICEBERG_VERSION=1.12.0
# Spark's Kafka connector and the versions its 3.5.9 POM declares.
SPARK_KAFKA_VERSION=3.5.9
KAFKA_CLIENTS_VERSION=3.4.1
COMMONS_POOL2_VERSION=2.11.1

# Producer events per second; 500 replays the whole dataset in about 1 h.
RATE=20
# Caps one streaming batch, so catching up after a long stop takes several small MERGEs.
MAX_OFFSETS_PER_TRIGGER=50000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
POSTGRES_PASSWORD=change-me-postgres
METASTORE_DB_PASSWORD=change-me-metastore
AIRFLOW_DB_PASSWORD=change-me-airflow
METABASE_DB_PASSWORD=change-me-metabase
# Metabase web login, created by `make metabase-setup`.
METABASE_ADMIN_EMAIL=admin@example.com
# Metabase rejects passwords without a digit.
METABASE_ADMIN_PASSWORD=change-me-metabase-1
# Grafana web login: user admin.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Salt for card_hash in Silver; changing it later breaks joins on card_hash with older rows.
HASH_SALT=change-me-salt

# Failure emails (Gmail with an app password); delivery is checked in build step 7.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@gmail.com
SMTP_PASSWORD=change-me-app-password
ALERT_EMAIL=change-me@example.com
