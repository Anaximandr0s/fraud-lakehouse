# Copy to .env (gitignored) and replace the passwords.

MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
POSTGRES_IMAGE=postgres:18.7
# Not 4.x: Hive 4 metastores drop the get_table call that Spark 3.5's Hive client uses.
HIVE_IMAGE=apache/hive:3.1.3
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
KAFKA_IMAGE=apache/kafka:4.3.2
# Same Python as the Spark image.
PYTHON_IMAGE=python:3.10.22-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.13.7

POSTGRES_JDBC_VERSION=42.7.14
# Must match the Hadoop 3.3.4 bundled with Spark 3.5.
SPARK_HADOOP_AWS_VERSION=3.3.4
SPARK_AWS_SDK_V1_VERSION=1.12.262
ICEBERG_VERSION=1.12.0

# Producer events per second; 500 replays the whole dataset in about 1 h.
RATE=20

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
POSTGRES_PASSWORD=change-me-postgres
METASTORE_DB_PASSWORD=change-me-metastore
AIRFLOW_DB_PASSWORD=change-me-airflow
METABASE_DB_PASSWORD=change-me-metabase
