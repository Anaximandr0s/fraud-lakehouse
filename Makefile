.DEFAULT_GOAL := help
# A provenance attestation carries a timestamp: every build would get a new image ID, and
# docker compose up would recreate every container even when nothing changed.
export BUILDX_NO_DEFAULT_ATTESTATIONS := 1
.PHONY: help lint test jars data build up-core down logs beeline reset-producer silver-count reset-streaming dbt ml-features up-orchestration airflow-password dag-check up-bi metabase-setup metabase-check up-monitoring monitoring-check up-notebook notebook-run up-all control-center recovery-check psql

help: ## List targets
	@grep -E '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | awk -F':.*## ' '{printf "  %-16s %s\n", $$1, $$2}'

lint: ## ruff check + ruff format --check
	uv run ruff check .
	uv run ruff format --check .

test: ## Unit tests (pytest)
	uv run pytest

jars: ## Download pinned jars into jars/ and check their Maven sha1
	set -a && . ./.env && set +a && scripts/fetch_jars.sh

DATA_ZIP := data/raw/fraud-detection.zip

data: $(DATA_ZIP) ## Download the Kaggle dataset and merge it into data/fraud_all.csv
	uv run python scripts/prepare_data.py $(DATA_ZIP) data/fraud_all.csv

$(DATA_ZIP):
	mkdir -p $(@D)
	curl -fsSL --retry 5 --retry-all-errors -C - -o $@.part \
		https://www.kaggle.com/api/v1/datasets/download/kartik2112/fraud-detection
	mv $@.part $@

build: jars ## Build the Spark and producer images
	docker compose build

up-core: build data ## Start the core services and wait until healthy
	docker compose up -d --wait

up-orchestration: up-core ## Start Airflow (profile orchestration) on top of the core services
	docker compose --profile orchestration up -d --build --wait airflow

up-bi: up-core ## Start Metabase (profile bi) on top of the core services
	docker compose --profile bi up -d --wait --wait-timeout 180 metabase

metabase-setup: up-bi ## Create or update the Metabase admin, database and dashboards (idempotent)
	set -a && . ./.env && set +a && METABASE_URL=http://localhost:3000 \
		SPARK_THRIFT_HOST=spark-thrift SPARK_THRIFT_PORT=10000 uv run python scripts/metabase_setup.py

metabase-check: ## Run every dashboard card once and print its status, row count and first row
	set -a && . ./.env && set +a && METABASE_URL=http://localhost:3000 \
		uv run python scripts/metabase_setup.py check

up-monitoring: up-core ## Start Prometheus, Grafana and cAdvisor (profile monitoring)
	docker compose --profile monitoring up -d --wait --wait-timeout 180 cadvisor prometheus grafana

monitoring-check: ## Validate prometheus.yml and list each scrape target's health
	docker compose --profile monitoring exec -T prometheus promtool check config /etc/prometheus/prometheus.yml
	curl -fsS http://localhost:9090/api/v1/targets | uv run python -c "import json, sys; \
		[print(f'{t[\"labels\"][\"job\"]:16} {t[\"health\"]:6} {t[\"lastError\"]}') \
		for t in json.load(sys.stdin)['data']['activeTargets']]"

up-all: up-orchestration up-monitoring metabase-setup ## Start every profile but notebook, with the Metabase dashboards

control-center: ## Serve the control center on http://localhost:8099 (start, pause, stop from the browser)
	uv run python scripts/control_center.py

recovery-check: ## docker compose down then up: Silver keeps every row, gets no duplicate, streaming resumes
	uv run python scripts/recovery_check.py

up-notebook: up-core ## Start JupyterLab (profile notebook) on http://localhost:8888
	docker compose --profile notebook up -d --build --wait --wait-timeout 180 jupyter

notebook-run: up-notebook ml-features ## Run fraud_model.ipynb headless and print its results table
	docker compose --profile notebook exec -T jupyter jupyter nbconvert --to notebook --execute \
		--ExecutePreprocessor.timeout=3600 --output-dir out fraud_model.ipynb
	cat notebooks/out/results.md

airflow-password: ## Print the Airflow admin login generated by airflow standalone
	docker compose exec airflow cat /opt/airflow/simple_auth_manager_passwords.json.generated

dag-check: ## List DAG import errors inside the Airflow container (none expected)
	docker compose exec airflow airflow dags list-import-errors

down: ## Stop all services, every profile included (keeps volumes)
	docker compose --profile '*' down

logs: ## Follow one service's logs: make logs s=minio
	docker compose logs -f $(s)

beeline: ## SQL shell on the Spark Thrift Server
	docker compose run --rm --no-deps spark-thrift /opt/spark/bin/beeline -u jdbc:hive2://spark-thrift:10000

psql: ## SQL shell on PostgreSQL: db=metastore, airflow or metabase
	docker compose exec postgres psql -U postgres -d $(or $(db),postgres)

silver-count: ## Row counts of Bronze and Silver, and Silver duplicates (should be 0)
	docker compose run --rm --no-deps -T spark-thrift /opt/spark/bin/beeline --silent=true \
		-u jdbc:hive2://spark-thrift:10000 -e "SELECT \
		(SELECT count(*) FROM bronze.transactions_raw) AS bronze, \
		(SELECT count(*) FROM silver.transactions) AS silver, \
		(SELECT count(*) - count(DISTINCT trans_num) FROM silver.transactions) AS silver_duplicates, \
		(SELECT count(*) FROM silver.transactions_rejected) AS rejected"

dbt: ## Run dbt from the host against spark-thrift: make dbt args="run"
	cd dbt && DBT_SPARK_HOST=localhost uv run dbt $(args) --profiles-dir .

ml-features: ## Build gold.ml_features (dbt tag ml, not in the 10-min refresh)
	$(MAKE) dbt args="run --select tag:ml"

reset-producer: ## Stop the producer and make it replay the CSV from the start
	docker compose stop producer
	docker compose run --rm --no-deps --entrypoint rm producer -f /state/position

reset-streaming: ## Stop streaming and delete its checkpoint: it restarts from the earliest Kafka offset
	docker compose stop spark-streaming
	docker compose run --rm --no-deps --entrypoint rm spark-streaming -r -f /opt/spark/checkpoints/streaming
